# Copiar este archivo a .env y completar los valores reales:
#   cp .env.example .env
#   chmod 600 .env
#
# El archivo .env NO se versiona. No subir claves reales al repositorio.

# Clave de Flask para firmar la sesión.
# Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Conexión a MySQL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=escaperoom
MYSQL_PASSWORD=cambiar-esta-clave
MYSQL_DB=escape_room_7b2026

# Usuario del panel /admin. La clave se guarda como hash, nunca en texto plano.
# Generar el hash con:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('CAMBIA-ESTA-CLAVE'))"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=cambiar-por-el-hash-generado

# Opcional: nombre de la base que usan los tests.
# Debe terminar en _test y ser distinta de MYSQL_DB.
# TEST_MYSQL_DB=escape_room_7b2026_test
