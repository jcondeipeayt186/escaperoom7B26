# Escape Room 7.º B 2026 - variables de entorno
#
# Copiar este archivo a .env y completar los valores reales:
#   cp .env.example .env
#   chmod 600 .env
#
# El archivo .env NO se versiona.

# Clave de sesión de Flask.
# Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Conexión a MySQL (base escape_room_7b2026).
# Si la clave tiene espacios, #, $, comillas o barras, escribirla entre
# comillas dobles.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=escaperoom
MYSQL_PASSWORD=una-clave-larga-y-propia
MYSQL_DB=escape_room_7b2026

# Usuario del panel de administración.
# Generar el hash de la clave con:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('CAMBIA-ESTA-CLAVE'))"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=cambiar-por-el-hash-generado
